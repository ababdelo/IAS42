# ----------------------------------- #
# Application Core Settings           #
# ----------------------------------- #
APP_ENV=dev
APP_TIMEZONE=Africa/Casablanca
WEBSITE_NAME="IAS42"
WEBSITE_DESCRIPTION="Intelligent Agriculture System, an innovative solution for smart farming and sustainable agriculture."
DEVELOPPER_NAME=your-name
WEBSITE_URL=https://localhost
APP_DOMAIN=localhost
APP_DOMAIN_ALIASES=localhost 127.0.0.1

# ----------------------------------- #
# Database Configuration (MySQL)      #
# ----------------------------------- #
PMA_HOST=mysql
PMA_PORT=3306
MYSQL_ROOT_PASSWORD=root-password
MYSQL_DATABASE_NAME=IAS42_DB
MYSQL_USER=database-user
MYSQL_PASSWORD=database-password
MYSQL_ALLOW_EMPTY_PASSWORD=0

# ----------------------------------- #
# Authentication / OAuth (Google)     #
# ----------------------------------- #
OAUTH_CLIENT_ID=your-google-client-id
OAUTH_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=https://localhost/auth/oauth

# ----------------------------------- #
# SMTP Mail Configuration (PHPMailer) #
# ----------------------------------- #
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER_TYPE=SMTP
PASS_APP_MAIL=your-email@example.com
PASS_APP_KEY=your-mail-password-or-app-password

# ----------------------------------- #
# Hardware / IoT Configuration (MQTT)   #
# ----------------------------------- #
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_TOPIC_PREFIX=your-topic-prefix
IAS_DEVICE_ID=your-device-id
MQTT_CONTROL_TOPIC=control
MQTT_TELEMETRY_TOPIC=telemetry
