RewriteEngine On
RewriteBase /
Options -Indexes

RewriteRule ^(?:\.git|\.svn|\.hg)(?:/|$) - [F,L,NC]
RewriteRule ^(?:wp-admin|wp-login(?:\.php)?|wp-content|wp-includes|wordpress|xmlrpc(?:\.php)?)(?:/|$) - [F,L,NC]
RewriteRule ^(?:phpinfo|php-info|phpversion|info|debug|server-info|server-status)(?:\.php)?$ - [F,L,NC]

RewriteRule ^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|Dockerfile|docker-compose(?:\.ya?ml)?|Makefile|\.env(?:\..*)?)$ - [F,L,NC]
RewriteRule ^(?:backend/utils|backend/includes|backend/config|utils|includes|config|frontend/components|components|frontend/templates|templates)(?:/|$) - [F,L,NC]

RewriteCond %{THE_REQUEST} \s/+backend/ [NC]
RewriteRule ^backend/ - [F,L]

RewriteCond %{THE_REQUEST} \s/+frontend/ [NC]
RewriteRule ^frontend/ - [F,L]

RewriteCond %{THE_REQUEST} \s/+frontend/errors/handler\.php(?:[\s?]) [NC]
RewriteRule ^ - [F,L,NC]

RewriteRule (^|/)\.(?!well-known(?:/|$)).*$ - [F,L,NC]
RewriteRule (^|/).*\.(?:env|ini|log|sql|bak|old|backup|zip|tar|gz|7z|rar|pem|key|crt|csr)$ - [F,L,NC]

RewriteCond %{REQUEST_URI} !(?:^/|/$)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !^/frontend/errors/handler\.php$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.?\s]+)\.php(?:[?\s]|/) [NC]
RewriteRule ^ %1 [R=301,L,NE]

RewriteRule ^$ index.php [END]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

RewriteCond frontend/$1.php -f
RewriteRule ^(.*)$ frontend/$1.php [END]

RewriteRule ^auth/authenticate/?$ frontend/auth/authenticate.php [END,QSA]
RewriteRule ^auth/recover/?$ frontend/auth/recover.php [END,QSA]
RewriteRule ^auth/setup/?$ frontend/auth/setup.php [END,QSA]

RewriteCond frontend/policies/$1.php -f
RewriteRule ^(.*)$ frontend/policies/$1.php [END]

RewriteCond backend/$1.php -f
RewriteRule ^(.*)$ backend/$1.php [END]

RewriteCond backend/$1 -f
RewriteRule ^(.*)$ backend/$1 [END]

RewriteCond %{REQUEST_URI} ^/frontend/errors/handler\.php$ [NC]
RewriteRule ^ - [END]

ErrorDocument 400 /frontend/errors/handler.php
ErrorDocument 401 /frontend/errors/handler.php
ErrorDocument 403 /frontend/errors/handler.php
ErrorDocument 404 /frontend/errors/handler.php
ErrorDocument 408 /frontend/errors/handler.php
ErrorDocument 413 /frontend/errors/handler.php
ErrorDocument 500 /frontend/errors/handler.php
ErrorDocument 503 /frontend/errors/handler.php
